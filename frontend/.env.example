# Neer Niti frontend environment variables
# Copy to .env for local overrides. Do NOT put secrets here — anything
# prefixed with VITE_ is bundled into the client and is publicly visible.

# Optional. Base URL of the backend API (without a trailing /api/v1).
# Leave unset in development: the Vite dev proxy forwards /api and /health
# to http://localhost:8000 automatically.
# Example for a hosted backend:
# VITE_API_BASE_URL=https://api.your-domain.com
