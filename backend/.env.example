# Neer Niti Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="NeerNiti Smart Farming API"
APP_VERSION="0.1.0"
DEBUG=false
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database
# Default: SQLite (local dev). For PostgreSQL uncomment the line below.
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./neerniti.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/neerniti

# ---------------------------------------------------------------------------
# Admin API Key
# Protects POST /api/v1/fertilizers and POST /api/v1/fertilizers/prices/import.
# MUST be changed to a strong random value before any deployment.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
ADMIN_API_KEY=change-me-in-production

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed origins
# ---------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---------------------------------------------------------------------------
# Weather API (Open-Meteo — free, no key required)
# ---------------------------------------------------------------------------
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_SECONDS=1800

# ---------------------------------------------------------------------------
# ML Model (paths relative to repository root)
# Run ml/src/models/train_classifier.py once to generate these files.
# ---------------------------------------------------------------------------
ML_MODEL_PATH=ml/artifacts/fertilizer_classifier.pkl
ML_LABEL_ENCODER_PATH=ml/artifacts/label_encoder.pkl
ML_SCALER_PATH=ml/artifacts/feature_scaler.pkl
ML_MODEL_VERSION=1.0.0

# ---------------------------------------------------------------------------
# Soil validation thresholds (configurable, agronomically justified)
# ---------------------------------------------------------------------------
SOIL_PH_AGRONOMIC_MIN=4.0
SOIL_PH_AGRONOMIC_MAX=8.5
SOIL_EC_HIGH_THRESHOLD=4.0
SOIL_N_HIGH_THRESHOLD=500.0
